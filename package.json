{
  "name": "pdf-audiokniha",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "typecheck": "tsc --noEmit -p .",
    "postinstall": "node apps/mobile/scripts/patch-onnxruntime.mjs && node apps/mobile/scripts/embed-pdfjs.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
